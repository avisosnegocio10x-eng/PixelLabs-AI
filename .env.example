# Aplicación
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ADMIN_API_TOKEN=replace-with-a-long-random-value
TRUST_PROXY=false

# Chatbot existente
VERIFY_TOKEN=
GEMINI_API_KEY=
PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
EMAIL_USER=
EMAIL_PASS=

# Supabase (solo backend; nunca exponer SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pixellabs-content

# Content Engine
CONTENT_ENGINE_ENABLED=true
CONTENT_ENGINE_AUTO_PUBLISH=false
CONTENT_ENGINE_MAX_UPLOAD_BYTES=53687091200
CONTENT_ENGINE_CHUNK_BYTES=8388608
CONTENT_ENGINE_UPLOAD_DIR=./storage/uploads
CONTENT_ENGINE_WORK_DIR=./storage/work
CONTENT_ENGINE_MAX_CONCURRENT_VIDEO_JOBS=1
CONTENT_ENGINE_RETENTION_DAYS=30

# Integraciones sociales (se completan mediante OAuth/configuración segura)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# n8n
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=
