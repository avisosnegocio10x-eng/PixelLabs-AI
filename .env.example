# Aplicación
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ADMIN_API_TOKEN=replace-with-a-long-random-value
TRUST_PROXY=false

# Chatbot existente
VERIFY_TOKEN=
GEMINI_API_KEY=
PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
EMAIL_USER=
EMAIL_PASS=

# Supabase (solo backend; nunca exponer SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pixellabs-content
LOCAL_WORKER_API_TOKEN=replace-with-a-different-long-random-value
LOCAL_WORKER_MAX_ARTIFACT_BYTES=50331648

# Content Engine
CONTENT_ENGINE_ENABLED=true
REQUIRE_SUPABASE=false
CONTENT_ENGINE_AUTO_PUBLISH=false
AUTO_PUBLICATION=false
CONTENT_ENGINE_AI_ENABLED=false
CONTENT_ENGINE_GEMINI_MODEL=gemini-3.5-flash-lite
CONTENT_ENGINE_GEMINI_FREE_TIER_CONFIRMED=false
CONTENT_ENGINE_GEMINI_MAX_REQUESTS_PER_DAY=12
CONTENT_ENGINE_MAX_UPLOAD_BYTES=53687091200
CONTENT_ENGINE_CHUNK_BYTES=8388608
CONTENT_ENGINE_UPLOAD_DIR=./storage/uploads
CONTENT_ENGINE_WORK_DIR=./storage/work
CONTENT_ENGINE_VIDEO_MODE=local
CONTENT_ENGINE_LOCAL_STORAGE_DURABLE=false
CONTENT_ENGINE_MAX_CONCURRENT_VIDEO_JOBS=1
CONTENT_ENGINE_RETENTION_DAYS=30

# Agente local de video (solo en la PC; no guardar el token en Git)
LOCAL_WORKER_API_URL=http://localhost:3000
LOCAL_WORKER_ID=pixellabs-pc-principal
LOCAL_WORKER_INBOX_DIR=./local-worker/inbox
LOCAL_WORKER_WORK_DIR=./local-worker/work
LOCAL_WORKER_POLL_MS=5000
LOCAL_WORKER_CLIP_STYLE=process-real

# Integraciones sociales (se completan mediante OAuth/configuración segura)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_REDIRECT_URI=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_VERIFIED_MEDIA_URL_PREFIX=

# n8n
N8N_WEBHOOK_SECRET=
N8N_REQUIRE_HTTPS=true
N8N_BASE_URL=
PIXELLABS_API_URL=
PIXELLABS_N8N_API_TOKEN=

# Publicación: mantener draft hasta autorización explícita
SOCIAL_PUBLISH_MODE=draft
SOCIAL_EXTERNAL_REQUESTS_ENABLED=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_ENABLED=false
