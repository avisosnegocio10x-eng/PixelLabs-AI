# Copia este archivo como config.env. config.env está ignorado por Git.
# Genera una clave aleatoria distinta y no vuelvas a cambiarla después de
# guardar credenciales en n8n.
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_ALEATORIOS_EN_BASE64

# URL pública; no es un secreto.
PIXELLABS_API_URL=https://pixellabs-content-engine-free.onrender.com

# Debe contener exactamente el valor N8N_WEBHOOK_SECRET configurado en Render.
# Nunca uses aquí ADMIN_API_TOKEN, LOCAL_WORKER_API_TOKEN ni service_role.
PIXELLABS_N8N_API_TOKEN=REEMPLAZAR_DESDE_RENDER_SIN_COMPARTIR_EN_CHAT
